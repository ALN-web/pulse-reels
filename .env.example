# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Voice: ElevenLabs (free tier) ---
# Get the key at elevenlabs.io -> Developers -> API Keys
ELEVENLABS_API_KEY=
# Dr. Ira's voice. Run `npm run voices` to list the ones your key can use, then paste an id here.
ELEVENLABS_VOICE_ID=
# Optional overrides
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Free tier = 0. If we upgrade, put the plan's price per 1,000 characters so run.json logs real cost.
ELEVENLABS_USD_PER_1K_CHARS=0

# --- Optional: only if we buy a Higgsfield plan for realistic Dr. Ira clips ---
HIGGSFIELD_ENABLED=false
